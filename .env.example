# === Required for production ===
SECRET_KEY=change-me-to-a-random-32+-character-string

# === Database ===
# Default: SQLite (no setup needed). For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/compliance

# === Email (optional — needed for reminders) ===
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=yourpassword
SMTP_FROM=noreply@yourdomain.com

# === App URL ===
FRONTEND_URL=http://localhost:3000

# === SSO (optional — OIDC/OAuth2) ===
SSO_ENABLED=false
SSO_PROVIDER=okta   # okta | azure | google | generic
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DISCOVERY_URL=https://your-provider/.well-known/openid-configuration
